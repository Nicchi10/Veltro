$SSL_PRINCIPAL_MAPPING_RULES_CONFIG String = "ssl.principal.mapping.rules"
$DEFAULT_SSL_PRINCIPAL_MAPPING_RULES String = "DEFAULT"
$SSL_PRINCIPAL_MAPPING_RULES_DOC String
$SASL_KERBEROS_PRINCIPAL_TO_LOCAL_RULES_CONFIG String = "sasl.kerberos.principal.to.local.rules"
$DEFAULT_SASL_KERBEROS_PRINCIPAL_TO_LOCAL_RULES List<String>
$SASL_KERBEROS_PRINCIPAL_TO_LOCAL_RULES_DOC String
$PRINCIPAL_BUILDER_CLASS_DEFAULT Class<KafkaPrincipalBuilder>
$PRINCIPAL_BUILDER_CLASS_DOC String
$SSL_CLIENT_AUTH_CONFIG String = "ssl.client.auth"
$SSL_CLIENT_AUTH_DEFAULT String
$SSL_CLIENT_AUTH_DOC String = "Configures kafka broker to request client authentication. The following settings are common:  <ul> <li><code>ssl.client.auth=required</code> If set to required client authentication is required. <li><code>ssl.client.auth=requested</code> This means client authentication is optional. unlike required, if this option is set client can choose not to provide authentication information about itself <li><code>ssl.client.auth=none</code> This means client authentication is not needed.</ul>"
$SASL_ENABLED_MECHANISMS_CONFIG String = "sasl.enabled.mechanisms"
$DEFAULT_SASL_ENABLED_MECHANISMS List<String>
$SASL_ENABLED_MECHANISMS_DOC String = "The list of SASL mechanisms enabled in the Kafka server. The list may contain any mechanism for which a security provider is available. Only GSSAPI is enabled by default."
$SASL_SERVER_CALLBACK_HANDLER_CLASS_CONFIG String = "sasl.server.callback.handler.class"
$SASL_SERVER_CALLBACK_HANDLER_CLASS_DOC String = "The fully qualified name of a SASL server callback handler class that implements the AuthenticateCallbackHandler interface. Server callback handlers must be prefixed with listener prefix and SASL mechanism name in lower-case. For example, listener.name.sasl_ssl.plain.sasl.server.callback.handler.class=com.example.CustomPlainCallbackHandler."
$CONNECTIONS_MAX_REAUTH_MS_CONFIG String = "connections.max.reauth.ms"
$DEFAULT_CONNECTIONS_MAX_REAUTH_MS long = 0L
$CONNECTIONS_MAX_REAUTH_MS_DOC String = "When explicitly set to a positive number (the default is 0, not a positive number), a session lifetime that will not exceed the configured value will be communicated to v2.2.0 or later clients when they authenticate. The broker will disconnect any such connection that is not re-authenticated within the session lifetime and that is then subsequently used for any purpose other than re-authentication. Configuration names can optionally be prefixed with listener prefix and SASL mechanism name in lower-case. For example, listener.name.sasl_ssl.oauthbearer.connections.max.reauth.ms=3600000"
$SASL_SERVER_MAX_RECEIVE_SIZE_CONFIG String = "sasl.server.max.receive.size"
$DEFAULT_SASL_SERVER_MAX_RECEIVE_SIZE int = 524288
$SASL_SERVER_MAX_RECEIVE_SIZE_DOC String = "The maximum receive size allowed before and during initial SASL authentication. Default receive size is 512KB. GSSAPI limits requests to 64K, but we allow upto 512KB by default for custom SASL mechanisms. In practice, PLAIN, SCRAM and OAUTH mechanisms can use much smaller limits."
$SSL_ALLOW_DN_CHANGES_CONFIG String = "ssl.allow.dn.changes"
$DEFAULT_SSL_ALLOW_DN_CHANGES_VALUE boolean = false
$SSL_ALLOW_DN_CHANGES_DOC String = "Indicates whether changes to the certificate distinguished name should be allowed during a dynamic reconfiguration of certificates or not."
$SSL_ALLOW_SAN_CHANGES_CONFIG String = "ssl.allow.san.changes"
$DEFAULT_SSL_ALLOW_SAN_CHANGES_VALUE boolean = false
$SSL_ALLOW_SAN_CHANGES_DOC String = "Indicates whether changes to the certificate subject alternative names should be allowed during a dynamic reconfiguration of certificates or not."
$SASL_MECHANISM_INTER_BROKER_PROTOCOL_CONFIG String = "sasl.mechanism.inter.broker.protocol"
$SASL_MECHANISM_INTER_BROKER_PROTOCOL_DOC String = "SASL mechanism used for inter-broker communication. Default is GSSAPI."
$ALLOWED_SASL_OAUTHBEARER_URLS_CONFIG String = "org.apache.kafka.sasl.oauthbearer.allowed.urls"
$ALLOWED_SASL_OAUTHBEARER_URLS_DEFAULT String = ""
$ALLOWED_SASL_OAUTHBEARER_FILES_CONFIG String = "org.apache.kafka.sasl.oauthbearer.allowed.files"
$ALLOWED_SASL_OAUTHBEARER_FILES_DEFAULT String = ""
$CONFIG_DEF ConfigDef

module org.apache.kafka.common.config.provider
interface ConfigProvider
get(path String) ConfigData
get(path String, keys Set<String>) ConfigData
subscribe(path String, keys Set<String>, callback ConfigChangeCallback)
