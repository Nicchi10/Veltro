// yUML class diagram (yuml.me)
[MessageRole|System;User;Assistant;Tool]
[MemoryMode|None;FullHistory;Summary;Extractive;Hybrid]
[ILlmInvocation|+Conversation:ConversationState;+Memory:MemoryContext|+Validate():IValidationResult]
[IProviderAdapter|+ProviderName:String|+ExecuteAsync(ILlmInvocation):Task<LlmResponse>;+SupportsCapability(String):Boolean]
[IValidationResult|+IsValid:Boolean;+Errors:IEnumerable<String>]
[LlmInvocation|+Conversation:ConversationState;+Memory:MemoryContext|+Validate():IValidationResult]
[ConversationState|+TraceId:String;+TokenBudget:Int?;+Messages:List<Message>;+TurnIndex:Int=0]
[Message|+Role:MessageRole;+Content:String;+Metadata:Dictionary<String,Object>]
[GenerationOptions|+Temperature:Float?;+MaxTokens:Int?;+JsonMode:Boolean=False]
[MemoryContext|+Mode:MemoryMode;+TTL:TimeSpan?]
[ValidationResult|-_isValid:Boolean;+IsValid:Boolean|+Success():ValidationResult;+Failure(errors:IEnumerable<String>):ValidationResult]
[ILlmInvocation]^-.-[LlmInvocation]
[IValidationResult]^-.-[ValidationResult]
