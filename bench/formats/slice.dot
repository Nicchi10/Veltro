digraph Loom {
  node [shape=record, fontname="Helvetica"]

  MessageRole [label="{&laquo;enum&raquo; MessageRole|System\lUser\lAssistant\lTool\l}"]
  MemoryMode [label="{&laquo;enum&raquo; MemoryMode|None\lFullHistory\lSummary\lExtractive\lHybrid\l}"]
  ILlmInvocation [label="{&laquo;interface&raquo; ILlmInvocation|+ Conversation : ConversationState\l+ Memory : MemoryContext\l|+ Validate() : IValidationResult\l}"]
  IProviderAdapter [label="{&laquo;interface&raquo; IProviderAdapter|+ ProviderName : String\l|+ ExecuteAsync(ILlmInvocation) : Task\<LlmResponse\>\l+ SupportsCapability(String) : Boolean\l}"]
  IValidationResult [label="{&laquo;interface&raquo; IValidationResult|+ IsValid : Boolean\l+ Errors : IEnumerable\<String\>\l}"]
  LlmInvocation [label="{LlmInvocation|+ Conversation : ConversationState\l+ Memory : MemoryContext\l|+ Validate() : IValidationResult\l}"]
  ConversationState [label="{ConversationState|+ TraceId : String\l+ TokenBudget : Int?\l+ Messages : List\<Message\>\l+ TurnIndex : Int = 0\l}"]
  Message [label="{Message|+ Role : MessageRole\l+ Content : String\l+ Metadata : Dictionary\<String, Object\>\l}"]
  GenerationOptions [label="{GenerationOptions|+ Temperature : Float?\l+ MaxTokens : Int?\l+ JsonMode : Boolean = False\l}"]
  MemoryContext [label="{MemoryContext|+ Mode : MemoryMode\l+ TTL : TimeSpan?\l}"]
  ValidationResult [label="{ValidationResult|- _isValid : Boolean\l+ IsValid : Boolean\l|+ Success() : ValidationResult\l+ Failure(errors : IEnumerable\<String\>) : ValidationResult\l}"]

  edge [arrowhead=empty, style=dashed]
  LlmInvocation -> ILlmInvocation
  ValidationResult -> IValidationResult
}
